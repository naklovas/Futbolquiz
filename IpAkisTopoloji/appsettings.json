    "VirtualAreaId": 1,
    "ServisFormat": "tcp_{port}"
  },

  "F5": {
    "Enabled": true,
    "Index": "f5",
    "MaxUri": 300,
    "Alanlar": {}
  },

  "Erisim": {
    "MaxGun": 30
  },

  "Firewall": {
    "Enabled": true,
    "Index": "fw_paloalto",
    "IzinDegerleri": [ "allowed", "allow", "accept" ],
    "Alanlar": {
      "Reason": "session_end_reason",
      "SrcIp": "src_ip",
      "SrcPort": "src_port",
      "DestIp": "dest_ip",
      "DestPort": "dest_port",
      "Action": "action",
      "Rule": "rule",
      "Device": "dvc_name",
      "App": "app",
      "Duration": "duration"
    }
  },

  "Splunk": {
    "BaseUrl": "https://splunk.local:8089",
    "Token": "",
    "Index": "carbonblack",
    "Sourcetype": "bit9:carbonblack:json",
    "IgnoreSslErrors": false
  }
