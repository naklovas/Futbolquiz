    "MaxKarakter": 3500,
    "SmYil": 3,
    "SmMaxKayit": 12,
    "SmPaket": 25,
    "SmPaketMaxSatir": 3000,
    "SmBlobAra": true,
    "SqlTimeoutSaniye": 180,
    "TopolojiMaxIp": 400,
    "TopolojiParca": 80,
    "SmTalepLinki": "",
    "SmGorevLinki": "",
    "VersiyonTablosu": "dbo.DF_TOPOLOJI_VERSIYON",
    "VersiyonSayisi": 3,
    "Tablolar": {
      "Msy": "dbo.Envanter",
      "Csy": "dbo.CsyEnvanter",
      "Kahin": "dbo.SONUCLAR",
      "Request": "dbo.REQUESTM1",
      "Dept": "dbo.DEPTM1",
      "Change": "dbo.CM3RM1",
      "Kurulum": "dbo.ZTSUNUCUKURULUMUOPTIONSM1"
    }
  },

  "Eksik": {
    "OneriTablosu": "dbo.DF_ERT_UYGULAMA_ONERI",
    "Saat": 24,
    "Paket": 3,
    "Paralel": 2,
    "MaxIp": 200,
    "MaxKarakter": 6000,
    "SmTablolari": [ "dbo.REQUESTM1" ]
