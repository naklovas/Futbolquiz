  },
  "AllowedHosts": "*",

  "Auth": {
    "Enabled": true,
    "CacheMinutes": 5
  },
  "AppSettings": {
    "CurrentSiteName": "DeltaFlow",
    "DokuPanelApiUrl": "http://localhost/DokuPanel/api/config/get-groups-by-name?siteName=",
    "DokuPanelKey": ""
  },

  "ConnectionStrings": {
    "Envanter": "Server=SQLSUNUCU;Database=doku;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=15"
  },
  "Envanter": {
    "SegmentTablosu": "dbo.KonsolideSegmentler4",
    "HostTablosu": "dbo.ERT_HOSTIPADDRESS",
    "VipTablosu": "dbo.vip_envanteri",
    "VipGwTablosu": "dbo.vipgw",
    "EtiketKolonu": "TAG",
    "SistemPortuEtiketi": "Sistem Portudur",
