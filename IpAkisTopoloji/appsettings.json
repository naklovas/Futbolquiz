  },

  "MaxRangeHours": 24,
  "Hop2MaxPeers": 80,

  "Credentials": {
    "Username": "",
    "Password": ""
  },
  "Servers": [
    { "Name": "Riverbed-1", "Ip": "" }
  ],
  "SourcePathType": "jobs",
  "SourceL4": "flow_tcp",
  "SourceL7": "wtapages",
  "VifgIds": [],
