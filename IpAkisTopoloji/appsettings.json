  "Etiket": {
    "AciklamaTablosu": "dbo.DF_ETIKET_ACIKLAMA",
    "MaxUzunluk": 200
  },

  "Yolculuk": {
    "Geri": 3,
    "Ileri": 3,
    "Dallanma": 6,
    "DisGeri": 6,
    "DisDallanma": 15,
    "SeviyeMax": 60,
