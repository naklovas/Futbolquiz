{
  "AppEnvironment": "prod",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ITInventory": "Server=CHANGE_ME;Database=ITInventory;Trusted_Connection=True;Encrypt=True;TrustServerCertificate=False;"
  },
  "Vrops": {
    "Host": "CHANGE_ME",
    "AuthSource": "Local",
    "SkipCertificateValidation": false,
    "CacheMinutes": 5
  },
  "Ldap": {
    "Domain": "fintek.local",
    "Servers": [ "fintek.local" ],
    "Port": 636,
    "UseSsl": true
  }
}
