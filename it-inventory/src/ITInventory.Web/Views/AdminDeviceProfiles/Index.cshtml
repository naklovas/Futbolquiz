@model List<ITInventory.Data.Entities.DeviceProfileCatalog>
@{
    ViewData["Title"] = "Cihaz Profilleri";
    var categories = (List<ITInventory.Data.Entities.DeviceCategory>)ViewBag.Categories;
}

<h2>Cihaz Profilleri (Nessus DeviceProfile Eşlemesi)</h2>
<p class="text-muted">
    Nessus taramalarında görülen her DeviceProfile değerinin hangi envanter kategorisine
    ait olduğunu buradan belirleyebilirsiniz. Cihaz havuzu bu eşlemeyi kullanır.
</p>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Cihaz Profili (Nessus)</th>
            <th>Kategori</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProfileName</td>
                <td>
                    <form asp-action="UpdateCategory" asp-route-id="@p.Id" method="post" class="d-flex gap-2">
                        <select name="categoryId" class="form-select form-select-sm">
                            <option value="">-- Kategori Yok --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == p.CategoryId)">@cat.Name</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Kaydet</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
