@model List<ITInventory.Data.Entities.DeviceProfileCatalog>
@{
    ViewData["Title"] = "Device Profiles";
    var categories = (List<ITInventory.Data.Entities.DeviceCategory>)ViewBag.Categories;
}

<h2>Device Profiles (Nessus DeviceProfile Mapping)</h2>
<p class="text-muted">
    Assign each DeviceProfile value seen in Nessus scans to an inventory category here.
    The device pool uses this mapping.
</p>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Device Profile (Nessus)</th>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.ProfileName</td>
                <td>
                    <form asp-action="UpdateCategory" asp-route-id="@p.Id" method="post" class="d-flex gap-2">
                        <select name="categoryId" class="form-select form-select-sm">
                            <option value="">-- No Category --</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat.Id" selected="@(cat.Id == p.CategoryId)">@cat.Name</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-primary">Save</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
