@model ITInventory.Web.Models.Applications.ApplicationFormViewModel
@{
    var countryOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.CountryOptions;
    var companyOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.CompanyOptions;
    var licenseOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.LicenseOptions;
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div>
        <label asp-for="CountryId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        @if (isAdmin)
        {
            <select asp-for="CountryId" asp-items="countryOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="">-- Select --</option>
            </select>
        }
        else
        {
            <select asp-for="CountryId" asp-items="countryOptions" class="w-full rounded-md border border-slate-200 bg-slate-100 px-3 py-2 text-sm" disabled></select>
            <input type="hidden" asp-for="CountryId" />
        }
        <span asp-validation-for="CountryId" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="Name" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        <span asp-validation-for="Name" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="ApplicationType" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="ApplicationType" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select --</option>
            <option value="Mobile">Mobile</option>
            <option value="Web">Web</option>
            <option value="Desktop">Desktop</option>
        </select>
        <span asp-validation-for="ApplicationType" class="text-sm text-red-600"></span>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
        <label asp-for="CompanyId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="CompanyId" asp-items="companyOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select --</option>
        </select>
        <span asp-validation-for="CompanyId" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="LicenseId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="LicenseId" asp-items="licenseOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select --</option>
        </select>
        <span asp-validation-for="LicenseId" class="text-sm text-red-600"></span>
    </div>
</div>

<div class="mb-4">
    <label asp-for="Url" class="block text-sm font-medium text-slate-700 mb-1"></label>
    <input asp-for="Url" placeholder="https://..." class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    <span asp-validation-for="Url" class="text-sm text-red-600"></span>
</div>

<div class="flex flex-wrap items-center gap-6 mb-6">
    <div class="flex items-center gap-2">
        <input asp-for="IsExternallyExposed" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        <label asp-for="IsExternallyExposed" class="text-sm font-medium text-slate-700"></label>
    </div>
    <div class="flex items-center gap-2">
        <input asp-for="IsCloudApplication" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        <label asp-for="IsCloudApplication" class="text-sm font-medium text-slate-700"></label>
    </div>
</div>

<div class="mb-6">
    <label asp-for="Notes" class="block text-sm font-medium text-slate-700 mb-1"></label>
    <textarea asp-for="Notes" rows="3" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></textarea>
</div>

<div class="flex gap-2">
    <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-5 py-2.5 rounded-md">Save</button>
    <a asp-action="Index" class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-5 py-2.5 rounded-md">Cancel</a>
</div>
