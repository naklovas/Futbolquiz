@model List<ITInventory.Data.Entities.YdUser>
@{
    ViewData["Title"] = "Users";
    var countryDisplayNames = (Dictionary<string, string>)ViewBag.CountryDisplayNames;
}

<div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-semibold text-slate-900">Users</h2>
    <a asp-action="Create" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 rounded-md">
        <i class="fa-solid fa-plus"></i>New User
    </a>
</div>

<div class="mb-4 relative max-w-xs">
    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
    <input type="text" oninput="filterRows(this, 'users-table')" placeholder="Search users..."
           class="w-full pl-9 pr-3 py-2 text-sm rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
</div>

<div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-x-auto">
    <table id="users-table" class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50">
            <tr>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Username</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Full Name</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Email</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Country/Branch</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Roles</th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Active</th>
                <th class="px-4 py-3"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            @foreach (var user in Model)
            {
                <tr class="hover:bg-slate-50">
                    <td class="px-4 py-3 text-slate-700 font-medium">@user.Username</td>
                    <td class="px-4 py-3 text-slate-700">@user.FullName</td>
                    <td class="px-4 py-3 text-slate-700">@user.Email</td>
                    <td class="px-4 py-3 text-slate-700">
                    @(user.RepositoryName != null && countryDisplayNames.TryGetValue(user.RepositoryName, out var cdn) ? cdn : user.RepositoryName)
                </td>
                    <td class="px-4 py-3">
                        @foreach (var r in user.UserRoles)
                        {
                            <span class="inline-block bg-slate-100 text-slate-600 text-xs px-2 py-0.5 rounded-full mr-1 mb-1">@r.Role?.RoleName</span>
                        }
                    </td>
                    <td class="px-4 py-3">
                        @if (user.IsActive)
                        {
                            <span class="inline-flex items-center gap-1 text-brand-700 bg-brand-50 px-2 py-0.5 rounded-full text-xs font-medium"><i class="fa-solid fa-circle-check"></i>Yes</span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full text-xs font-medium">No</span>
                        }
                    </td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="text-brand-600 hover:text-brand-800 mr-3" title="Edit"><i class="fa-solid fa-pen"></i></a>
                        <button type="button" onclick="openConfirmModal('delete-form-@user.Id', 'Are you sure you want to delete this user?')" class="text-red-600 hover:text-red-800" title="Delete"><i class="fa-solid fa-trash"></i></button>
                        <form id="delete-form-@user.Id" asp-action="Delete" asp-route-id="@user.Id" method="post" class="hidden"></form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
