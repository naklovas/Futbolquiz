@model List<ITInventory.Data.Entities.YdUser>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kullanıcılar</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Kullanıcı</a>
</div>

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Kullanıcı Adı</th>
            <th>Ad Soyad</th>
            <th>E-posta</th>
            <th>Ülke/Şube</th>
            <th>Roller</th>
            <th>Aktif</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Username</td>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@user.RepositoryName</td>
                <td>@string.Join(", ", user.UserRoles.Select(ur => ur.Role?.RoleName))</td>
                <td>@(user.IsActive ? "Evet" : "Hayır")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
