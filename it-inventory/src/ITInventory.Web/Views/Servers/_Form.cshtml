@model ITInventory.Web.Models.Servers.ServerFormViewModel
@{
    var countryOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.CountryOptions;
    var vendorOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.VendorOptions;
    var hostPhysicalDeviceOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.HostPhysicalDeviceOptions;
    bool isAdmin = ViewBag.IsAdmin ?? false;
}

<div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-3"></div>
<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="DeviceProfileId" />
<input type="hidden" asp-for="SourceZiraatYdId" />

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div>
        <label asp-for="CountryId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        @if (isAdmin)
        {
            <select asp-for="CountryId" asp-items="countryOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="">-- Select --</option>
            </select>
        }
        else
        {
            <select asp-for="CountryId" asp-items="countryOptions" class="w-full rounded-md border border-slate-200 bg-slate-100 px-3 py-2 text-sm" disabled></select>
            <input type="hidden" asp-for="CountryId" />
        }
        <span asp-validation-for="CountryId" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="ApplianceType" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="ApplianceType" id="ApplianceType" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="Physical">Physical</option>
            <option value="Virtual">Virtual</option>
        </select>
    </div>
    <div>
        <label asp-for="HostName" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="HostName" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        <span asp-validation-for="HostName" class="text-sm text-red-600"></span>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div id="location-field">
        <label asp-for="Location" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="Location" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        <span asp-validation-for="Location" class="text-sm text-red-600"></span>
    </div>
    <div id="host-physical-device-field" class="hidden">
        <label asp-for="HostPhysicalDeviceId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="HostPhysicalDeviceId" asp-items="hostPhysicalDeviceOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- None --</option>
        </select>
        <p class="text-xs text-slate-400 mt-1">Which physical device (ESX host) this virtual server runs on.</p>
    </div>
    <div>
        <label asp-for="OperatingSystem" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="OperatingSystem" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
    <div>
        <label asp-for="Brand" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="Brand" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
    <div>
        <label asp-for="Model" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="Model" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
    <div>
        <label asp-for="SerialNo" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="SerialNo" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
    <div>
        <label asp-for="VendorSupplier" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="VendorSupplier" asp-items="vendorOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select --</option>
        </select>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div>
        <label asp-for="Branch" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="Branch" id="Branch" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select --</option>
        </select>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
    <div>
        <label asp-for="StartOfSupportDate" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="StartOfSupportDate" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
    <div>
        <label asp-for="EndOfSupportDate" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="EndOfSupportDate" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
    <div>
        <label asp-for="EndOfLifeDate" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="EndOfLifeDate" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
</div>

<div class="mb-6">
    <label asp-for="Notes" class="block text-sm font-medium text-slate-700 mb-1"></label>
    <textarea asp-for="Notes" rows="3" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></textarea>
</div>

<div class="flex gap-2">
    <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-5 py-2.5 rounded-md">Save</button>
    <a asp-action="Index" class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-5 py-2.5 rounded-md">Cancel</a>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        initBranchCombobox('Branch', @Html.Raw(Json.Serialize(ViewBag.AllLocations)), @Html.Raw(Json.Serialize(Model.Branch)));

        var applianceField = document.getElementById('ApplianceType');
        var locationField = document.getElementById('location-field');
        var hostField = document.getElementById('host-physical-device-field');

        function refreshApplianceFields() {
            var isVirtual = applianceField.value === 'Virtual';
            locationField.classList.toggle('hidden', isVirtual);
            hostField.classList.toggle('hidden', !isVirtual);
        }

        applianceField.addEventListener('change', refreshApplianceFields);
        refreshApplianceFields();
    });
</script>
