@model List<ITInventory.Data.Entities.Server>
@{
    ViewData["Title"] = "Servers";
    var countries = (List<ITInventory.Data.Entities.Country>)ViewBag.Countries;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    bool canEdit = ViewBag.CanEdit;
    bool isAdmin = ViewBag.IsAdmin;
}

<div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-semibold text-slate-900">Servers</h2>
    @if (canEdit)
    {
        <a asp-action="Create" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 rounded-md">
            <i class="fa-solid fa-plus"></i>Add New Server
        </a>
    }
</div>

<div class="flex flex-wrap items-center gap-3 mb-4">
    @if (isAdmin)
    {
        <form method="get">
            <select name="countryId" onchange="this.form.submit()" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="">All Countries</option>
                @foreach (var c in countries)
                {
                    <option value="@c.Id" selected="@(c.Id == selectedCountryId)">@(c.DisplayName ?? c.Name)</option>
                }
            </select>
        </form>
    }
    <div class="relative max-w-xs">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
        <input type="text" oninput="filterRows(this, 'servers-table')" placeholder="Search servers..."
               class="w-full pl-9 pr-3 py-2 text-sm rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-12 text-slate-400 bg-white rounded-lg border border-slate-200">
        <i class="fa-solid fa-inbox text-3xl mb-2"></i>
        <p class="text-sm">No records found.</p>
    </div>
}
else
{
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-x-auto">
        <table id="servers-table" class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    @if (isAdmin)
                    {
                        <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Country</th>
                    }
                    <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Host Name</th>
                    <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Physical/Virtual</th>
                    <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">IP</th>
                    <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Operating System</th>
                    <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Port</th>
                    <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Location</th>
                    <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Support End</th>
                    @if (canEdit)
                    {
                        <th class="px-4 py-3"></th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50">
                        @if (isAdmin)
                        {
                            <td class="px-4 py-3 text-slate-700">@(item.Country?.DisplayName ?? item.Country?.Name)</td>
                        }
                        <td class="px-4 py-3 text-slate-700 font-medium">@item.HostName</td>
                        <td class="px-4 py-3 text-slate-700">@item.ApplianceType</td>
                        <td class="px-4 py-3 text-slate-700 font-mono text-xs">@item.IpAddress</td>
                        <td class="px-4 py-3 text-slate-700">@item.OperatingSystem</td>
                        <td class="px-4 py-3 text-slate-700">@item.Port</td>
                        <td class="px-4 py-3 text-slate-700">@item.Location</td>
                        <td class="px-4 py-3 text-slate-700">@(item.EndOfSupportDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        @if (canEdit)
                        {
                            <td class="px-4 py-3 text-right whitespace-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-brand-600 hover:text-brand-800 mr-3" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" onclick="openConfirmModal('delete-form-@item.Id', 'Are you sure you want to delete this record?')" class="text-red-600 hover:text-red-800" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" class="hidden"></form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
