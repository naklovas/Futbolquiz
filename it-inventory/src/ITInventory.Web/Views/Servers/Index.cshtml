@model ITInventory.Web.Models.PagedResult<ITInventory.Data.Entities.Server>
@{
    ViewData["Title"] = "Servers";
    var countries = (List<ITInventory.Data.Entities.Country>)ViewBag.Countries;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    bool canEdit = ViewBag.CanEdit;
    bool isAdmin = ViewBag.IsAdmin;
    bool viewAll = ViewBag.ViewAll;
    bool requiresSelection = ViewBag.RequiresSelection;
    string? exportCountryId = viewAll ? "all" : selectedCountryId?.ToString();
}

<div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-semibold text-slate-900">Servers</h2>
    <div class="flex gap-2">
        @if (isAdmin && !requiresSelection)
        {
            <a asp-action="Export" asp-route-countryId="@exportCountryId" class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-4 py-2 rounded-md">
                <i class="fa-solid fa-file-arrow-down"></i>Export to Excel
            </a>
        }
        @if (isAdmin)
        {
            <a asp-action="Import" class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-4 py-2 rounded-md">
                <i class="fa-solid fa-file-excel"></i>Import from Excel
            </a>
        }
        @if (canEdit)
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 rounded-md">
                <i class="fa-solid fa-plus"></i>Add New Server
            </a>
        }
    </div>
</div>

<div class="flex flex-wrap items-center gap-3 mb-4">
    @if (isAdmin)
    {
        <form method="get">
            <select name="countryId" onchange="showLoadingOverlay(); this.form.submit();" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="" selected="@(requiresSelection)">-- Select Country --</option>
                <option value="all" selected="@viewAll">All Countries</option>
                @foreach (var c in countries)
                {
                    <option value="@c.Id" selected="@(c.Id == selectedCountryId)">@(c.DisplayName ?? c.Name)</option>
                }
            </select>
        </form>
    }
    <div class="flex items-center gap-2 ml-auto">
        <div class="relative max-w-xs">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" oninput="filterRows(this, 'servers-table')" placeholder="Search servers..."
                   class="w-full pl-9 pr-3 py-2 text-sm rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
        @await Html.PartialAsync("_ColumnChooserButton", "servers-table")
    </div>
</div>

@if (requiresSelection)
{
    <div class="bg-blue-50 border border-blue-200 text-blue-700 rounded-md px-4 py-3 text-sm">
        <i class="fa-solid fa-circle-info mr-1.5"></i>Select a country above (or choose "All Countries") to view records.
    </div>
}
else if (!Model.Items.Any())
{
    <div class="text-center py-12 text-slate-400 bg-white rounded-lg border border-slate-200">
        <i class="fa-solid fa-inbox text-3xl mb-2"></i>
        <p class="text-sm">No records found.</p>
    </div>
}
else
{
    <div class="bg-white rounded-lg shadow-sm border border-slate-200">
    <div class="overflow-x-auto">
        <table id="servers-table" data-colchooser="colprefs:servers" class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    @if (isAdmin)
                    {
                        <th data-col="country" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Country</th>
                    }
                    <th data-col="hostName" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Host Name</th>
                    <th data-col="applianceType" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Physical/Virtual</th>
                    <th data-col="locationCategory" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Location Category</th>
                    <th data-col="host" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Host (ESX)</th>
                    <th data-col="os" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Operating System</th>
                    <th data-col="location" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Location</th>
                    <th data-col="brandModel" data-default-hidden="true" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Brand/Model</th>
                    <th data-col="serialNo" data-default-hidden="true" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Serial No</th>
                    <th data-col="vendor" data-default-hidden="true" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Vendor/Supplier</th>
                    <th data-col="branch" data-default-hidden="true" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Branch</th>
                    <th data-col="supportStart" data-default-hidden="true" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Support Start</th>
                    <th data-col="supportEnd" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Support End</th>
                    <th data-col="endOfLife" data-default-hidden="true" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">End of Life</th>
                    <th data-col="notes" data-default-hidden="true" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Notes</th>
                    @if (canEdit)
                    {
                        <th class="px-4 py-3"></th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model.Items)
                {
                    <tr class="hover:bg-slate-50">
                        @if (isAdmin)
                        {
                            <td data-col="country" class="px-4 py-3 text-slate-700">@(item.Country?.DisplayName ?? item.Country?.Name)</td>
                        }
                        <td data-col="hostName" class="px-4 py-3 text-slate-700 font-medium">@item.HostName</td>
                        <td data-col="applianceType" class="px-4 py-3 text-slate-700">@item.ApplianceType</td>
                        <td data-col="locationCategory" class="px-4 py-3 text-slate-700">@item.LocationCategory</td>
                        <td data-col="host" class="px-4 py-3 text-slate-700">@item.HostPhysicalDevice?.DeviceName</td>
                        <td data-col="os" class="px-4 py-3 text-slate-700">@item.OperatingSystem</td>
                        <td data-col="location" class="px-4 py-3 text-slate-700">@item.Location</td>
                        <td data-col="brandModel" class="px-4 py-3 text-slate-700">@item.Brand @item.Model</td>
                        <td data-col="serialNo" class="px-4 py-3 text-slate-700 font-mono text-xs">@item.SerialNo</td>
                        <td data-col="vendor" class="px-4 py-3 text-slate-700">@item.VendorSupplier</td>
                        <td data-col="branch" class="px-4 py-3 text-slate-700">@item.Branch</td>
                        <td data-col="supportStart" class="px-4 py-3 text-slate-700">@(item.StartOfSupportDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td data-col="supportEnd" class="px-4 py-3 text-slate-700">@(item.EndOfSupportDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td data-col="endOfLife" class="px-4 py-3 text-slate-700">@(item.EndOfLifeDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td data-col="notes" class="px-4 py-3 text-slate-700 max-w-xs truncate" title="@item.Notes">@item.Notes</td>
                        @if (canEdit)
                        {
                            <td class="px-4 py-3 text-right whitespace-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-brand-600 hover:text-brand-800 mr-3" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" onclick="openConfirmModal('delete-form-@item.Id', 'Are you sure you want to delete this record?')" class="text-red-600 hover:text-red-800" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" class="hidden"></form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", ITInventory.Web.Models.PaginationInfo.From(Model))
    </div>
}
