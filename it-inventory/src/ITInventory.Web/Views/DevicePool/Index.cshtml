@model List<ITInventory.Web.Models.DevicePool.DiscoveredDeviceDto>
@{
    ViewData["Title"] = "Device Pool";
    var countries = (List<ITInventory.Data.Entities.Country>)ViewBag.Countries;
    var categories = (List<ITInventory.Data.Entities.DeviceCategory>)ViewBag.Categories;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
    bool isAdmin = ViewBag.IsAdmin;
    bool noCountryAssigned = ViewBag.NoCountryAssigned ?? false;
    bool showingAllCountries = ViewBag.ShowingAllCountries ?? false;
}

<h2>Device Pool</h2>
<p class="text-muted">Devices discovered in Nessus scans. Select from the relevant row to add it to the inventory.</p>

@if (noCountryAssigned)
{
    <div class="alert alert-warning">
        No country is assigned to your account. Please contact your system administrator.
    </div>
}
else
{
    <form method="get" class="row g-2 mb-3">
        @if (isAdmin)
        {
            <div class="col-auto">
                <select name="countryId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Countries</option>
                    @foreach (var c in countries)
                    {
                        <option value="@c.Id" selected="@(c.Id == selectedCountryId)">@c.Name</option>
                    }
                </select>
            </div>
        }
        <div class="col-auto">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(cat.Id == selectedCategoryId)">@cat.Name</option>
                }
            </select>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary">No discovered devices found for this country/category.</div>
    }
    else
    {
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    @if (showingAllCountries)
                    {
                        <th>Country</th>
                    }
                    <th>IP Address</th>
                    <th>DNS / Netbios</th>
                    <th>MAC</th>
                    <th>Operating System</th>
                    <th>Device Profile</th>
                    <th>Category</th>
                    <th>Last Seen</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        @if (showingAllCountries)
                        {
                            <td>@d.Country</td>
                        }
                        <td>@d.IpAddress</td>
                        <td>@(d.DnsName ?? d.NetbiosName)</td>
                        <td>@d.MacAddress</td>
                        <td>@d.OperatingSystem</td>
                        <td>@d.DeviceProfile</td>
                        <td>@d.CategoryName</td>
                        <td>@(d.LastSeenAt?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>
                            @if (d.AlreadyInInventory)
                            {
                                <span class="badge bg-secondary">In Inventory</span>
                            }
                            else
                            {
                                <div class="btn-group btn-group-sm">
                                    <a class="btn btn-outline-primary"
                                       asp-controller="PhysicalDevices" asp-action="Create"
                                       asp-route-fromPool="true"
                                       asp-route-sourceId="@d.ZiraatYdId"
                                       asp-route-countryId="@selectedCountryId"
                                       asp-route-categoryId="@d.CategoryId">
                                        Add as Physical Device
                                    </a>
                                    <a class="btn btn-outline-primary"
                                       asp-controller="Servers" asp-action="Create"
                                       asp-route-fromPool="true"
                                       asp-route-sourceId="@d.ZiraatYdId"
                                       asp-route-countryId="@selectedCountryId">
                                        Add as Server
                                    </a>
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
