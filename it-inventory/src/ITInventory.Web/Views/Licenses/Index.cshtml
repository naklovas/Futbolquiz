@model List<ITInventory.Data.Entities.License>
@{
    ViewData["Title"] = "Licenses";
    var countries = (List<ITInventory.Data.Entities.Country>)ViewBag.Countries;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    bool canEdit = ViewBag.CanEdit;
    bool isAdmin = ViewBag.IsAdmin;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Licenses</h2>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New License</a>
    }
</div>

@if (isAdmin)
{
    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="countryId" class="form-select" onchange="this.form.submit()">
                <option value="">All Countries</option>
                @foreach (var c in countries)
                {
                    <option value="@c.Id" selected="@(c.Id == selectedCountryId)">@c.Name</option>
                }
            </select>
        </div>
    </form>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">No records found.</div>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                @if (isAdmin)
                {
                    <th>Country</th>
                }
                <th>License Name</th>
                <th>Vendor/Supplier</th>
                <th>Branch</th>
                <th>Location</th>
                <th>Support Start</th>
                <th>Support End</th>
                @if (canEdit)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td>@item.Country?.Name</td>
                    }
                    <td>@item.LicenseName</td>
                    <td>@item.VendorSupplier</td>
                    <td>@item.Branch</td>
                    <td>@item.Location</td>
                    <td>@(item.SupportStartDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                    <td>@(item.SupportEndDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                    @if (canEdit)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this record?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
