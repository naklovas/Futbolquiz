@model ITInventory.Web.Models.Home.DashboardViewModel
@{
    ViewData["Title"] = "Home";
}

<h2 class="mb-4">Overview</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">@Model.PhysicalDeviceCount</h5>
                <p class="card-text text-muted">Physical Devices</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">@Model.ServerCount</h5>
                <p class="card-text text-muted">Servers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">@Model.LicenseCount</h5>
                <p class="card-text text-muted">Licenses</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">@Model.CircuitCount</h5>
                <p class="card-text text-muted">Circuits</p>
            </div>
        </div>
    </div>
</div>

<h4>Upcoming Expirations (within 90 days)</h4>
@if (!Model.ExpiringItems.Any())
{
    <div class="alert alert-success">No upcoming expirations.</div>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th>Type</th>
                <th>Name</th>
                <th>Country</th>
                <th>Expiration Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ExpiringItems)
            {
                <tr class="@(item.ExpiresAt < DateTime.UtcNow ? "table-danger" : "")">
                    <td>@item.Type</td>
                    <td>@item.Name</td>
                    <td>@item.Country</td>
                    <td>@item.ExpiresAt.ToString("dd.MM.yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
}
