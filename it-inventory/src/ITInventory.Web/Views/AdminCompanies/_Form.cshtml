@model ITInventory.Web.Models.Admin.CompanyFormViewModel

<div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div>
        <label asp-for="Name" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="Name" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        <span asp-validation-for="Name" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="CountryOfOrigin" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="CountryOfOrigin" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
    </div>
</div>

<div class="flex items-center gap-2 mb-6">
    <input asp-for="IsActive" class="rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
    <label asp-for="IsActive" class="text-sm font-medium text-slate-700"></label>
</div>

<div class="mb-6">
    <div class="flex items-center justify-between mb-2">
        <label class="block text-sm font-medium text-slate-700">Contacts</label>
        <button type="button" id="add-contact-btn" class="text-sm font-medium text-brand-700 hover:text-brand-800">
            <i class="fa-solid fa-plus mr-1"></i>Add Contact
        </button>
    </div>
    <p class="text-xs text-slate-400 mb-2">Optional. Add as many people as needed (name, title, phone, email).</p>

    <div id="contacts-list" class="space-y-2"></div>
</div>

<div class="flex gap-2">
    <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-5 py-2.5 rounded-md">Save</button>
    <a asp-action="Index" class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-5 py-2.5 rounded-md">Cancel</a>
</div>

<template id="contact-row-template">
    <div class="contact-row grid grid-cols-1 md:grid-cols-[1fr_1fr_1fr_1fr_auto] gap-2 items-start bg-slate-50 border border-slate-200 rounded-md p-3">
        <input type="hidden" class="contact-id" value="0" />
        <input type="text" placeholder="Name" class="contact-name w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        <input type="text" placeholder="Title" class="contact-title w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        <input type="text" placeholder="Phone" class="contact-phone w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        <input type="email" placeholder="Email" class="contact-email w-full rounded-md border border-slate-300 px-3 py-2 text-sm" />
        <button type="button" class="remove-contact-btn text-red-600 hover:text-red-800 px-2 py-2" title="Remove">
            <i class="fa-solid fa-trash"></i>
        </button>
    </div>
</template>

    <script>
        (function () {
            var list = document.getElementById('contacts-list');
            var template = document.getElementById('contact-row-template');
            var addBtn = document.getElementById('add-contact-btn');
            var initialContacts = @Html.Raw(Json.Serialize(Model.Contacts));

            function reindex() {
                var rows = list.querySelectorAll('.contact-row');
                rows.forEach(function (row, i) {
                    row.querySelector('.contact-id').name = 'Contacts[' + i + '].Id';
                    row.querySelector('.contact-name').name = 'Contacts[' + i + '].PersonName';
                    row.querySelector('.contact-title').name = 'Contacts[' + i + '].Title';
                    row.querySelector('.contact-phone').name = 'Contacts[' + i + '].Phone';
                    row.querySelector('.contact-email').name = 'Contacts[' + i + '].Email';
                });
            }

            function addRow(contact) {
                var node = template.content.cloneNode(true);
                var row = node.querySelector('.contact-row');
                if (contact) {
                    row.querySelector('.contact-id').value = contact.Id || 0;
                    row.querySelector('.contact-name').value = contact.PersonName || '';
                    row.querySelector('.contact-title').value = contact.Title || '';
                    row.querySelector('.contact-phone').value = contact.Phone || '';
                    row.querySelector('.contact-email').value = contact.Email || '';
                }
                row.querySelector('.remove-contact-btn').addEventListener('click', function () {
                    row.remove();
                    reindex();
                });
                list.appendChild(row);
            }

            if (initialContacts.length > 0) {
                initialContacts.forEach(addRow);
            } else {
                addRow(null);
            }
            reindex();

            addBtn.addEventListener('click', function () {
                addRow(null);
                reindex();
            });
        })();
    </script>
