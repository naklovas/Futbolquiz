@model ITInventory.Web.Models.ServerEndpoints.ServerEndpointFormViewModel
@{
    ViewData["Title"] = "Edit Server Endpoint";
}

<h2 class="text-xl font-semibold text-slate-900 mb-6">Edit Server Endpoint</h2>

<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6 max-w-3xl">
