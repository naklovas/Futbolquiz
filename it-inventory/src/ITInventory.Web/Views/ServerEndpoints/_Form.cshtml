@model ITInventory.Web.Models.ServerEndpoints.ServerEndpointFormViewModel
@{
    var serverOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.ServerOptions;
    var applicationOptions = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.ApplicationOptions;
}

<div asp-validation-summary="ModelOnly" class="text-sm text-red-600 mb-3"></div>
<input type="hidden" asp-for="Id" />

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
        <label asp-for="ServerId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="ServerId" asp-items="serverOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select --</option>
        </select>
        <span asp-validation-for="ServerId" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="ApplicationId" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <select asp-for="ApplicationId" asp-items="applicationOptions" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select --</option>
        </select>
        <span asp-validation-for="ApplicationId" class="text-sm text-red-600"></span>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
    <div>
        <label asp-for="IpAddress" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="IpAddress" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        <span asp-validation-for="IpAddress" class="text-sm text-red-600"></span>
    </div>
    <div>
        <label asp-for="Port" class="block text-sm font-medium text-slate-700 mb-1"></label>
        <input asp-for="Port" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        <span asp-validation-for="Port" class="text-sm text-red-600"></span>
    </div>
</div>

<div class="mb-6">
    <label asp-for="Notes" class="block text-sm font-medium text-slate-700 mb-1"></label>
    <textarea asp-for="Notes" rows="3" class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500"></textarea>
</div>

<div class="flex gap-2">
    <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-5 py-2.5 rounded-md">Save</button>
    <a asp-action="Index" class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-5 py-2.5 rounded-md">Cancel</a>
</div>
