@model ITInventory.Web.Models.Account.LoginViewModel
@inject Microsoft.Extensions.Options.IOptionsSnapshot<ITInventory.Web.Configuration.TestLoginSettings> TestLoginOptions
@{
    ViewData["Title"] = "Log In";
    Layout = "_LoginLayout";
    var testLoginEnabled = TestLoginOptions.Value.Enabled;
    var testLoginPassword = TestLoginOptions.Value.Password;
}

<div class="login-box">
    <h3 class="mb-3 text-center">IT Inventory System</h3>
    <p class="text-muted text-center mb-4">Sign in with your fintek.local account, or as a test user</p>

    <form asp-controller="Account" asp-action="Login" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" name="LoginMode" value="ldap" class="btn btn-primary w-100 mb-2">Log In with AD (LDAP)</button>
        @if (testLoginEnabled)
        {
            <div class="d-flex align-items-center my-2 text-muted small">
                <hr class="flex-grow-1" />
                <span class="px-2">or</span>
                <hr class="flex-grow-1" />
            </div>
            <button type="submit" name="LoginMode" value="test" class="btn btn-outline-secondary w-100">Log In as Test User</button>

            <div class="alert alert-info small mt-3 mb-0">
                <strong>Test users</strong> (type the username above, password <code>@testLoginPassword</code>, then click "Log In as Test User" — this skips AD):
                <ul class="mb-0 ps-3 mt-1">
                    <li><code>germany_test</code> &mdash; sees only Germany's inventory</li>
                    <li><code>bulgaria_test</code> &mdash; sees only Bulgaria's inventory</li>
                </ul>
            </div>
        }
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
