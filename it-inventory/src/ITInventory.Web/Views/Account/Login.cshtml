@model ITInventory.Web.Models.Account.LoginViewModel
@inject Microsoft.Extensions.Options.IOptionsSnapshot<ITInventory.Web.Configuration.TestLoginSettings> TestLoginOptions
@{
    ViewData["Title"] = "Log In";
    Layout = "_LoginLayout";
    var testLoginEnabled = TestLoginOptions.Value.Enabled;
    var testLoginPassword = TestLoginOptions.Value.Password;
}

<div class="bg-white rounded-xl shadow-lg w-full max-w-sm p-8">
    <div class="text-center mb-6">
        <img src="~/images/ziraat-bank-logo.png" alt="Ziraat Bank" class="h-10 w-auto mx-auto mb-3" />
        <h3 class="text-lg font-semibold text-slate-900">IT Inventory System</h3>
        <p class="text-sm text-slate-500 mt-1">Sign in with your fintek.local account, or as a test user</p>
    </div>

    <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <div>
            <label asp-for="Username" class="block text-sm font-medium text-slate-700 mb-1"></label>
            <input asp-for="Username" autocomplete="username" autofocus
                   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            <span asp-validation-for="Username" class="text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-slate-700 mb-1"></label>
            <input asp-for="Password" autocomplete="current-password"
                   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
            <span asp-validation-for="Password" class="text-sm text-red-600"></span>
        </div>

        <button type="submit" name="LoginMode" value="ldap"
                class="w-full bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium rounded-md py-2.5 transition">
            <i class="fa-solid fa-lock mr-1.5"></i>Log In with AD (LDAP)
        </button>

        @if (testLoginEnabled)
        {
            <div class="flex items-center gap-3 text-xs text-slate-400">
                <hr class="flex-1 border-slate-200" /> or <hr class="flex-1 border-slate-200" />
            </div>

            <button type="submit" name="LoginMode" value="test"
                    class="w-full bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-sm font-medium rounded-md py-2.5 transition">
                <i class="fa-solid fa-flask mr-1.5"></i>Log In as Test User
            </button>

            <div class="bg-brand-50 border border-brand-100 rounded-md p-3 text-xs text-slate-600">
                <p class="font-medium text-slate-700 mb-1"><i class="fa-solid fa-circle-info mr-1"></i>Test users</p>
                <p class="mb-2">Type the username above, password <code class="bg-white px-1 py-0.5 rounded border border-slate-200">@testLoginPassword</code>, then click "Log In as Test User" (this skips AD).</p>
                <ul class="list-disc list-inside space-y-0.5">
                    <li><code class="bg-white px-1 py-0.5 rounded border border-slate-200">germany_test</code> &mdash; can view, add and edit Germany's inventory</li>
                    <li><code class="bg-white px-1 py-0.5 rounded border border-slate-200">bulgaria_test</code> &mdash; can view, add and edit Bulgaria's inventory</li>
                    <li><code class="bg-white px-1 py-0.5 rounded border border-slate-200">germany_view_test</code> &mdash; view-only, sees Germany's inventory but cannot add, edit, delete or import anything</li>
                </ul>
            </div>
        }
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
