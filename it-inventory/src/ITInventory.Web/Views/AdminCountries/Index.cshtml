@model List<ITInventory.Data.Entities.Country>
@{
    ViewData["Title"] = "Ülkeler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ülkeler</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Ülke</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Kod</th>
            <th>Aktif</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Name</td>
                <td>@c.Code</td>
                <td>@(c.IsActive ? "Evet" : "Hayır")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Bu ülkeyi silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
