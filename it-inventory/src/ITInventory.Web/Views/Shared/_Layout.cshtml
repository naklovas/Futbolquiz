<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Envanter</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ITInventory.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">IT Envanter</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PhysicalDevices" asp-action="Index">Fiziksel Cihazlar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Servers" asp-action="Index">Sunucular</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Licenses" asp-action="Index">Lisanslar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Circuits" asp-action="Index">Hatlar</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="DevicePool" asp-action="Index">Cihaz Havuzu</a>
                            </li>
                            @if (User.IsInRole("admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Yönetim</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="AdminUsers" asp-action="Index">Kullanıcılar</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminCountries" asp-action="Index">Ülkeler</a></li>
                                        <li><a class="dropdown-item" asp-controller="AdminDeviceProfiles" asp-action="Index">Cihaz Profilleri</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item d-flex align-items-center me-2">
                                <span class="text-muted small">
                                    @User.FindFirst(ITInventory.Web.Services.AppClaimTypes.FullName)?.Value
                                    @{
                                        var country = User.FindFirst(ITInventory.Web.Services.AppClaimTypes.Country)?.Value;
                                    }
                                    @if (!string.IsNullOrEmpty(country))
                                    {
                                        <text> (@country)</text>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - IT Envanter Sistemi
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
