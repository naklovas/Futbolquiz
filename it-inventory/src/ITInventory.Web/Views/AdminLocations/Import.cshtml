@{
    ViewData["Title"] = "Import Locations from Excel";
}

<h2 class="text-xl font-semibold text-slate-900 mb-1">Import Locations from Excel</h2>
<p class="text-sm text-slate-500 mb-6">Upload an .xlsx file to add multiple branches at once, across any number of countries.</p>

<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6 max-w-2xl">
    <div class="bg-blue-50 border border-blue-200 text-blue-700 rounded-md px-4 py-3 text-sm mb-5">
        <i class="fa-solid fa-circle-info mr-1.5"></i>
        Don't have a file yet? <a asp-action="DownloadTemplate" class="underline font-medium">Download the Excel template</a> first.
        Each row needs a <strong>Country</strong> (must match a name already under Admin &gt; Countries),
        a <strong>Branch</strong>, and a <strong>Class</strong> (e.g. "Yurtdışı Şube"). Rows whose country
        isn't found yet are skipped and reported after import -- add the missing country first, then
        re-upload the same file.
    </div>

    @if (TempData["ImportError"] is string error)
    {
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-md px-4 py-3 text-sm mb-5">@error</div>
    }

    <form asp-action="Import" method="post" enctype="multipart/form-data" class="space-y-4">
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Excel file (.xlsx)</label>
            <input type="file" name="file" accept=".xlsx" required
                   class="w-full text-sm text-slate-700 file:mr-3 file:py-2 file:px-4 file:rounded-md file:border-0 file:bg-brand-50 file:text-brand-700 file:text-sm file:font-medium hover:file:bg-brand-100" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-5 py-2.5 rounded-md">
                <i class="fa-solid fa-upload mr-1.5"></i>Upload and Import
            </button>
            <a asp-action="Index" class="border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-5 py-2.5 rounded-md">Cancel</a>
        </div>
    </form>
</div>
