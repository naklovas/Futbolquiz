@model ITInventory.Web.Models.PagedResult<ITInventory.Data.Entities.Company>
@{
    ViewData["Title"] = "Companies";
    var countries = (List<ITInventory.Data.Entities.Country>)ViewBag.Countries;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    bool canEdit = ViewBag.CanEdit;
    bool isAdmin = ViewBag.IsAdmin;
    bool viewAll = ViewBag.ViewAll;
    bool requiresSelection = ViewBag.RequiresSelection;
    string? exportCountryId = viewAll ? "all" : selectedCountryId?.ToString();
}

<div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-semibold text-slate-900">Companies</h2>
    <div class="flex gap-2">
        @if (isAdmin && !requiresSelection)
        {
            <a asp-action="Export" asp-route-countryId="@exportCountryId" class="inline-flex items-center gap-2 border border-slate-300 text-slate-700 hover:bg-slate-50 text-sm font-medium px-4 py-2 rounded-md">
                <i class="fa-solid fa-file-arrow-down"></i>Export to Excel
            </a>
        }
        @if (canEdit)
        {
            <a asp-action="Create" class="inline-flex items-center gap-2 bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 rounded-md">
                <i class="fa-solid fa-plus"></i>New Company
            </a>
        }
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-md px-4 py-3 text-sm mb-4">@error</div>
}

<div class="flex flex-wrap items-center gap-3 mb-4">
    @if (isAdmin)
    {
        <form method="get">
            <select name="countryId" onchange="showLoadingOverlay(); this.form.submit();" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                <option value="" selected="@(requiresSelection)">-- Select Country --</option>
                <option value="all" selected="@viewAll">All Countries</option>
                @foreach (var c in countries)
                {
                    <option value="@c.Id" selected="@(c.Id == selectedCountryId)">@(c.DisplayName ?? c.Name)</option>
                }
            </select>
        </form>
    }
    <div class="flex items-center gap-2 ml-auto">
        <div class="relative max-w-xs">
            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
            <input type="text" oninput="filterRows(this, 'companies-table')" placeholder="Search companies..."
                   class="w-full pl-9 pr-3 py-2 text-sm rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500" />
        </div>
        @await Html.PartialAsync("_ColumnChooserButton", "companies-table")
    </div>
</div>

@if (requiresSelection)
{
    <div class="bg-blue-50 border border-blue-200 text-blue-700 rounded-md px-4 py-3 text-sm">
        <i class="fa-solid fa-circle-info mr-1.5"></i>Select a country above (or choose "All Countries") to view records.
    </div>
}
else if (!Model.Items.Any())
{
    <div class="text-center py-12 text-slate-400 bg-white rounded-lg border border-slate-200">
        <i class="fa-solid fa-inbox text-3xl mb-2"></i>
        <p class="text-sm">No records found.</p>
    </div>
}
else
{
    <div class="bg-white rounded-lg shadow-sm border border-slate-200">
    <div class="overflow-x-auto">
        <table id="companies-table" data-colchooser="colprefs:companies" class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-50">
                <tr>
                    @if (isAdmin)
                    {
                        <th data-col="country" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Country</th>
                    }
                    <th data-col="name" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Company Name</th>
                    <th data-col="origin" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Country of Origin</th>
                    <th data-col="contacts" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Contacts</th>
                    <th data-col="active" class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs">Active</th>
                    @if (canEdit)
                    {
                        <th class="px-4 py-3"></th>
                    }
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var item in Model.Items)
                {
                    <tr class="hover:bg-slate-50">
                        @if (isAdmin)
                        {
                            <td data-col="country" class="px-4 py-3 text-slate-700">@(item.Country?.DisplayName ?? item.Country?.Name)</td>
                        }
                        <td data-col="name" class="px-4 py-3 text-slate-700 font-medium">@item.Name</td>
                        <td data-col="origin" class="px-4 py-3 text-slate-700">@item.OriginCountry?.Name</td>
                        <td data-col="contacts" class="px-4 py-3 text-slate-500">
                            @if (item.Contacts.Any())
                            {
                                <span>@string.Join(", ", item.Contacts.Select(x => x.PersonName ?? x.Title ?? x.Email ?? "(contact)"))</span>
                            }
                        </td>
                        <td data-col="active" class="px-4 py-3">
                            @if (item.IsActive)
                            {
                                <span class="inline-flex items-center gap-1 text-brand-700 bg-brand-50 px-2 py-0.5 rounded-full text-xs font-medium"><i class="fa-solid fa-circle-check"></i>Yes</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full text-xs font-medium">No</span>
                            }
                        </td>
                        @if (canEdit)
                        {
                            <td class="px-4 py-3 text-right whitespace-nowrap">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="text-brand-600 hover:text-brand-800 mr-3" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <button type="button" onclick="openConfirmModal('delete-form-@item.Id', 'Are you sure you want to delete this company?')" class="text-red-600 hover:text-red-800" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" class="hidden"></form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", ITInventory.Web.Models.PaginationInfo.From(Model))
    </div>
}
