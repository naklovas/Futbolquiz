@model List<ITInventory.Data.Entities.PhysicalDevice>
@{
    ViewData["Title"] = "Physical Devices";
    var countries = (List<ITInventory.Data.Entities.Country>)ViewBag.Countries;
    var categories = (List<ITInventory.Data.Entities.DeviceCategory>)ViewBag.Categories;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
    bool canEdit = ViewBag.CanEdit;
    bool isAdmin = ViewBag.IsAdmin;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Physical Devices</h2>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn btn-primary">+ Add New Device</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    @if (isAdmin)
    {
        <div class="col-auto">
            <select name="countryId" class="form-select" onchange="this.form.submit()">
                <option value="">All Countries</option>
                @foreach (var c in countries)
                {
                    <option value="@c.Id" selected="@(c.Id == selectedCountryId)">@c.Name</option>
                }
            </select>
        </div>
    }
    <div class="col-auto">
        <select name="categoryId" class="form-select" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id" selected="@(cat.Id == selectedCategoryId)">@cat.Name</option>
            }
        </select>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-secondary">No records found.</div>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                @if (isAdmin)
                {
                    <th>Country</th>
                }
                <th>Category</th>
                <th>Device Name</th>
                <th>Brand/Model</th>
                <th>Physical/Virtual</th>
                <th>IP</th>
                <th>Location</th>
                <th>Support End</th>
                @if (canEdit)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td>@item.Country?.Name</td>
                    }
                    <td>@item.Category?.Name</td>
                    <td>@item.DeviceName</td>
                    <td>@item.Brand @item.Model</td>
                    <td>@item.ApplianceType</td>
                    <td>@item.IpAddress</td>
                    <td>@item.Location</td>
                    <td>@(item.EndOfSupportDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                    @if (canEdit)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete this record?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
