@model ITInventory.Data.Entities.CountryTopologyFile?
@{
    ViewData["Title"] = "Network Topology";
    bool isAdmin = ViewBag.IsAdmin ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    string? countryLabel = ViewBag.CountryLabel;
}

<h2 class="text-xl font-semibold text-slate-900 mb-1">Network Topology</h2>
<p class="text-sm text-slate-500 mb-6">One logical network topology diagram per country -- PDF, Visio (.vsdx/.vsd), draw.io (.drawio) or image (.png/.jpg), max 20 MB.</p>

@if (TempData["Success"] != null)
{
    <div class="bg-green-50 border border-green-200 text-green-700 rounded-md px-4 py-3 text-sm mb-4">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-md px-4 py-3 text-sm mb-4">@TempData["Error"]</div>
}

@if (isAdmin)
{
    <form method="get" class="mb-6">
        <select name="countryId" onchange="this.form.submit();" class="rounded-md border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
            <option value="">-- Select Country --</option>
            @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.CountryOptions)
            {
                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
            }
        </select>
    </form>
}

@if (!selectedCountryId.HasValue)
{
    <div class="bg-blue-50 border border-blue-200 text-blue-700 rounded-md px-4 py-3 text-sm">
        <i class="fa-solid fa-circle-info mr-1.5"></i>Select a country to view its topology diagram.
    </div>
}
else
{
    <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6 max-w-xl">
        @if (!isAdmin)
        {
            <h3 class="text-sm font-medium text-slate-500 mb-4">@countryLabel</h3>
        }

        @if (Model is null)
        {
            <p class="text-sm text-slate-400 mb-4">No topology diagram uploaded yet.</p>
        }
        else
        {
            <div class="flex items-center gap-3 mb-4 bg-slate-50 border border-slate-200 rounded-md p-3">
                <i class="fa-solid fa-diagram-project text-xl text-brand-600"></i>
                <div class="flex-1 min-w-0">
                    <div class="text-sm font-medium text-slate-700 truncate">@Model.FileName</div>
                    <div class="text-xs text-slate-400">@((Model.FileSize / 1024.0).ToString("N0")) KB &middot; uploaded @Model.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm") @(Model.UploadedBy != null ? $"by {Model.UploadedBy}" : "")</div>
                </div>
                <a asp-action="Download" asp-route-countryId="@selectedCountryId" class="text-xs font-medium text-brand-700 bg-brand-50 hover:bg-brand-100 px-3 py-1.5 rounded-md whitespace-nowrap">
                    <i class="fa-solid fa-download mr-1"></i>Download
                </a>
            </div>
        }

        @if (canEdit)
        {
            <form id="topology-upload-form" asp-action="Upload" method="post" enctype="multipart/form-data" class="flex items-center gap-2">
                <input type="hidden" name="countryId" value="@selectedCountryId" />
                <div class="flex-1">
                    <input type="file" id="topology-file-input" name="file" accept=".pdf,.vsdx,.vsd,.drawio,.png,.jpg,.jpeg" required
                           class="w-full text-sm text-slate-600 file:mr-3 file:py-2 file:px-3 file:rounded-md file:border-0 file:bg-slate-100 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200" />
                    <p id="topology-file-error" class="hidden text-xs text-red-600 mt-1"></p>
                </div>
                <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium px-4 py-2 rounded-md whitespace-nowrap">
                    @(Model is null ? "Upload" : "Replace")
                </button>
            </form>

            @if (Model is not null)
            {
                <form asp-action="Delete" method="post" class="mt-2" onsubmit="return confirm('Delete the topology diagram for this country?');">
                    <input type="hidden" name="countryId" value="@selectedCountryId" />
                    <button type="submit" class="text-xs font-medium text-red-600 hover:text-red-800">
                        <i class="fa-solid fa-trash mr-1"></i>Delete
                    </button>
                </form>
            }
        }
    </div>

    <script>
        // Mirrors the server-side extension + magic-number check in CountryTopologyController
        // so a disallowed/renamed file (e.g. an .exe saved as diagram.png) never leaves the
        // browser at all -- some network-level protection on the server (antivirus / IIS)
        // resets the connection for recognizable executable content with a bare "HTTP ERROR
        // 400" before our own friendly validation message ever gets a chance to render.
        // Catching it here means the request for a bad file is never sent in the first place.
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('topology-upload-form');
            if (!form) return;

            var fileInput = document.getElementById('topology-file-input');
            var errorEl = document.getElementById('topology-file-error');

            var signatures = {
                '.pdf': [0x25, 0x50, 0x44, 0x46, 0x2D],
                '.png': [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A],
                '.jpg': [0xFF, 0xD8, 0xFF],
                '.jpeg': [0xFF, 0xD8, 0xFF],
                '.vsdx': [0x50, 0x4B, 0x03, 0x04],
                '.vsd': [0xD0, 0xCF, 0x11, 0xE0, 0xA1, 0xB1, 0x1A, 0xE1]
            };

            function getExtension(name) {
                var i = name.lastIndexOf('.');
                return i >= 0 ? name.slice(i).toLowerCase() : '';
            }

            function matchesSignature(bytes, ext) {
                if (ext === '.drawio') {
                    var text = new TextDecoder('utf-8').decode(bytes).replace(/^\uFEFF/, '').trimStart();
                    return text.charAt(0) === '<';
                }
                var sig = signatures[ext];
                if (!sig) return false;
                if (bytes.length < sig.length) return false;
                for (var i = 0; i < sig.length; i++) {
                    if (bytes[i] !== sig[i]) return false;
                }
                return true;
            }

            function showError(message) {
                errorEl.textContent = message;
                errorEl.classList.remove('hidden');
            }

            function clearError() {
                errorEl.classList.add('hidden');
                errorEl.textContent = '';
            }

            fileInput.addEventListener('change', clearError);

            form.addEventListener('submit', function (event) {
                var file = fileInput.files[0];
                if (!file) return;

                event.preventDefault();
                clearError();

                var ext = getExtension(file.name);
                if (!signatures[ext] && ext !== '.drawio') {
                    showError('Only PDF, Visio (.vsdx/.vsd), draw.io (.drawio) or image (.png/.jpg) files are supported.');
                    return;
                }

                var reader = new FileReader();
                reader.onload = function () {
                    var bytes = new Uint8Array(reader.result);
                    if (!matchesSignature(bytes, ext)) {
                        showError("The file's contents don't match its extension. Make sure it's a genuine " + ext.slice(1).toUpperCase() + " file.");
                        return;
                    }
                    showLoadingOverlay();
                    form.submit();
                };
                reader.onerror = function () {
                    showError('Could not read the selected file. Please try again.');
                };
                reader.readAsArrayBuffer(file.slice(0, 512));
            });
        });
    </script>
}
