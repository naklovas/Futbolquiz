@model List<ITInventory.Data.Entities.Circuit>
@{
    ViewData["Title"] = "Hatlar";
    var countries = (List<ITInventory.Data.Entities.Country>)ViewBag.Countries;
    int? selectedCountryId = ViewBag.SelectedCountryId;
    bool canEdit = ViewBag.CanEdit;
    bool isAdmin = ViewBag.IsAdmin;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Hatlar</h2>
    @if (canEdit)
    {
        <a asp-action="Create" class="btn btn-primary">+ Yeni Hat Ekle</a>
    }
</div>

@if (isAdmin)
{
    <form method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <select name="countryId" class="form-select" onchange="this.form.submit()">
                <option value="">Tüm Ülkeler</option>
                @foreach (var c in countries)
                {
                    <option value="@c.Id" selected="@(c.Id == selectedCountryId)">@c.Name</option>
                }
            </select>
        </div>
    </form>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">Kayıt bulunamadı.</div>
}
else
{
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                @if (isAdmin)
                {
                    <th>Ülke</th>
                }
                <th>Hat Tipi</th>
                <th>Kapasite</th>
                <th>Sağlayıcı</th>
                <th>Şube</th>
                <th>Lokasyon</th>
                <th>Bitiş Tarihi</th>
                @if (canEdit)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    @if (isAdmin)
                    {
                        <td>@item.Country?.Name</td>
                    }
                    <td>@item.CircuitType</td>
                    <td>@item.CircuitCapacity</td>
                    <td>@item.Provider</td>
                    <td>@item.Branch</td>
                    <td>@item.Location</td>
                    <td>@(item.EndDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                    @if (canEdit)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
