<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ITInventory.MailTemplatePreview</RootNamespace>
    <UserSecretsId>dotnet-ITInventory.MailTemplatePreview</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuses the real DB queries, recipient resolution, and mail-sending code as-is
         (ExpirationCheckService / SmtpEmailNotificationService / DummyEmailNotificationService)
         so testing here and running for real later (as a Windows Service) behave identically;
         this project just runs it once, immediately, with no daily-schedule wait. -->
    <ProjectReference Include="..\ITInventory.Data\ITInventory.Data.csproj" />
    <ProjectReference Include="..\ITInventory.ExpirationNotifier\ITInventory.ExpirationNotifier.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Drop the bank logo file in this folder as logo.png (or .jpg, see Program.cs,
         it looks for either) and it's picked up automatically, no project changes needed. -->
    <None Update="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="logo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
